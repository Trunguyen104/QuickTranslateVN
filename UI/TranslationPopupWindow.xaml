<Window x:Class="QuickTranslateVN.UI.TranslationPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="380"
        SizeToContent="Height"
        MaxHeight="420"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style x:Key="IconBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Margin" Value="1.5,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#334155"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="6">
        <Border Background="#181B23"
                BorderBrush="#2E3648"
                BorderThickness="1"
                CornerRadius="11">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.5" Color="#000000"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Compact Single-Row Toolbar (Draggable) -->
                <Border Grid.Row="0"
                        Background="#202532"
                        CornerRadius="11,11,0,0"
                        Padding="8,5"
                        Cursor="SizeAll"
                        MouseLeftButtonDown="Header_MouseLeftButtonDown"
                        MouseMove="Header_MouseMove"
                        MouseLeftButtonUp="Header_MouseLeftButtonUp">
                    <DockPanel LastChildFill="False">
                        <Button DockPanel.Dock="Left"
                                Style="{StaticResource IconBtn}"
                                Background="#273248"
                                Foreground="#60A5FA"
                                FontFamily="Segoe UI Semibold"
                                Click="BtnSwapLang_Click"
                                ToolTip="Đảo chiều ngôn ngữ (VI ↔ EN)">
                            <TextBlock x:Name="TxtLangBadge" Text="EN → VI ⇄" FontSize="11.5"/>
                        </Button>

                        <TextBlock x:Name="TxtSpeed"
                                   DockPanel.Dock="Left"
                                   Foreground="#64748B"
                                   FontSize="10.5"
                                   VerticalAlignment="Center"
                                   Margin="6,0,0,0"/>

                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource IconBtn}"
                                Content="✕"
                                ToolTip="Đóng (ESC)"
                                Click="BtnClose_Click"/>

                        <Button x:Name="BtnPin"
                                DockPanel.Dock="Right"
                                Style="{StaticResource IconBtn}"
                                Content="📌"
                                Opacity="0.55"
                                ToolTip="Ghim cửa sổ"
                                Click="BtnPin_Click"/>

                        <Button x:Name="BtnCopy"
                                DockPanel.Dock="Right"
                                Style="{StaticResource IconBtn}"
                                Content="📋"
                                ToolTip="Sao chép bản dịch"
                                Click="BtnCopy_Click"/>

                        <Button x:Name="BtnReplace"
                                DockPanel.Dock="Right"
                                Style="{StaticResource IconBtn}"
                                Content="⏎"
                                ToolTip="Thay thế trực tiếp đoạn đang chọn bằng bản dịch"
                                Click="BtnReplace_Click"/>

                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource IconBtn}"
                                Content="🔊"
                                ToolTip="Nghe phát âm câu gốc"
                                Click="BtnSpeak_Click"/>
                    </DockPanel>
                </Border>

                <!-- Minimalist Translation Body -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              MaxHeight="350"
                              Padding="12,9,12,11">
                    <StackPanel>
                        <TextBlock x:Name="TxtPhonetic"
                                   Foreground="#94A3B8"
                                   FontStyle="Italic"
                                   FontSize="12"
                                   Margin="0,0,0,3"
                                   Visibility="Collapsed"/>

                        <TextBox x:Name="TxtTranslated"
                                 Text="Đang dịch..."
                                 Foreground="#F8FAFC"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 FontFamily="Segoe UI"
                                 FontSize="14.5"
                                 SelectionBrush="#2563EB"
                                 Padding="0"/>

                        <StackPanel x:Name="PanelDictionary"
                                    Margin="0,7,0,0"
                                    Visibility="Collapsed"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Window>
