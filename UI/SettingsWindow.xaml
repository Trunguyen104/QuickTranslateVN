<Window x:Class="QuickTranslateVN.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuickTranslateVN — Cài Đặt &amp; Lịch Sử Dịch"
        Width="600"
        Height="560"
        WindowStartupLocation="CenterScreen"
        Background="#13161E"
        Foreground="#F1F5F9"
        ResizeMode="CanMinimize">

    <Window.Resources>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="#1B202C"/>
            <Setter Property="BorderBrush" Value="#2D3548"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="ModernInput" TargetType="TextBox">
            <Setter Property="Background" Value="#11141C"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="CaretBrush" Value="#60A5FA"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" Background="#13161E" BorderBrush="#2D3548">
            <!-- TAB 1: Chung & Engine Dịch -->
            <TabItem Header="  ⚙️ Cài đặt &amp; Dịch vụ AI  " FontSize="13">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,12,8,4">
                    <StackPanel>
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="Thao tác kích hoạt &amp; Trải nghiệm" FontFamily="Segoe UI Semibold" FontSize="14" Foreground="#60A5FA" Margin="0,0,0,6"/>
                                <TextBlock Text="Phím tắt toàn cục: Alt + Q (Dịch vùng chọn)  •  Ctrl + Shift + T (Nhập nhanh)  •  Alt + S (Quét ảnh OCR)"
                                           Foreground="#94A3B8" FontSize="11.5" Margin="0,0,0,6" TextWrapping="Wrap"/>

                                <CheckBox x:Name="ChkFloatingBadge" Content="Hiện nút nổi [文A] cạnh trỏ chuột khi bôi đen chữ (kiểu Google Translate / Trayslate)"/>
                                <CheckBox x:Name="ChkDoubleCtrlC" Content="Dịch nhanh khi nhấn đúp Ctrl + C + C (kiểu DeepL for Windows)"/>
                                <CheckBox x:Name="ChkCleanPdf" Content="Tự động nối dòng bị ngắt &amp; từ gạch nối khi đọc tài liệu PDF"/>
                                <CheckBox x:Name="ChkBackTranslate" Content="Tự động hiển thị câu Dịch ngược (Back-translation) để kiểm chứng nghĩa"/>
                                <CheckBox x:Name="ChkStartup" Content=" Tự động khởi động cùng Windows"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="Nguồn Dịch Thuật (Translation Engine)" FontFamily="Segoe UI Semibold" FontSize="14" Foreground="#60A5FA" Margin="0,0,0,8"/>

                                <ComboBox x:Name="CmbProvider" Height="30" FontSize="13" Margin="0,0,0,10">
                                    <ComboBoxItem Content="Google Translate (Miễn phí • Có Từ điển &amp; Phiên âm — Khuyên dùng)" Tag="GoogleFree"/>
                                    <ComboBoxItem Content="Microsoft / Bing Translator (Miễn phí • Mượt cho đoạn văn dài)" Tag="MicrosoftFree"/>
                                    <ComboBoxItem Content="DeepL API (Cần API Key Free ':fx' hoặc Pro)" Tag="DeepL"/>
                                    <ComboBoxItem Content="AI / LLM (Ollama Offline 100% nội bộ, OpenAI, DeepSeek, Groq...)" Tag="OpenAiCompatible"/>
                                </ComboBox>

                                <TextBlock Text="DeepL API Key (Mã hóa bảo mật bằng Windows DPAPI trên máy):" Foreground="#CBD5E1" FontSize="12" Margin="0,2,0,3"/>
                                <PasswordBox x:Name="PwdDeepLKey" Background="#11141C" Foreground="#F8FAFC" BorderBrush="#334155" Padding="7,5" Margin="0,0,0,10"/>

                                <DockPanel Margin="0,2,0,4">
                                    <TextBlock Text="Cấu hình AI / Local Ollama (Chuẩn OpenAI-compatible):" Foreground="#CBD5E1" FontSize="12" VerticalAlignment="Center"/>
                                    <Button DockPanel.Dock="Right" Content="Điền mẫu DeepSeek" Padding="7,2" Margin="4,0,0,0" FontSize="11" Click="BtnPresetDeepSeek_Click"/>
                                    <Button DockPanel.Dock="Right" Content="Điền mẫu Ollama Offline" Padding="7,2" FontSize="11" Click="BtnPresetOllama_Click"/>
                                </DockPanel>

                                <TextBlock Text="Endpoint URL:" Foreground="#94A3B8" FontSize="11.5"/>
                                <TextBox x:Name="TxtLlmEndpoint" Style="{StaticResource ModernInput}" Margin="0,2,0,6"/>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Model Name (vd: qwen2.5:7b, gpt-4o-mini):" Foreground="#94A3B8" FontSize="11.5"/>
                                        <TextBox x:Name="TxtLlmModel" Style="{StaticResource ModernInput}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="API Key (Bỏ trống nếu dùng Ollama Offline):" Foreground="#94A3B8" FontSize="11.5"/>
                                        <PasswordBox x:Name="PwdLlmKey" Background="#11141C" Foreground="#F8FAFC" BorderBrush="#334155" Padding="7,5" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}" Margin="0">
                            <StackPanel>
                                <TextBlock Text="Quyền riêng tư &amp; Tối ưu RAM" FontFamily="Segoe UI Semibold" FontSize="14" Foreground="#60A5FA" Margin="0,0,0,6"/>
                                <CheckBox x:Name="ChkSaveHistory" Content="Lưu lịch sử các câu đã dịch trên máy (tắt để bật Chế độ Ẩn danh / Incognito)"/>
                                <CheckBox x:Name="ChkAutoTrimMemory" Content="Tự động thu gọn RAM hệ thống sau khi đóng Popup (giữ mức RAM nền siêu nhẹ)"/>
                                <TextBlock Text="🔒 Cam kết bảo mật: Ứng dụng không có telemetry, không đọc lén bàn phím ngầm, khóa API được mã hóa bằng Windows DPAPI."
                                           Foreground="#64748B" FontSize="11.5" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2: Lịch sử dịch -->
            <TabItem Header="  🕒 Lịch sử dịch gần đây  " FontSize="13">
                <Grid Margin="8,10,8,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Foreground="#94A3B8" FontSize="12" VerticalAlignment="Center"
                                   Text="Nháy đúp vào một mục để chép nhanh bản dịch vào Clipboard."/>
                        <Button DockPanel.Dock="Right" Content="🗑️ Xóa sạch lịch sử &amp; Cache"
                                Padding="10,4" Click="BtnClearHistory_Click"/>
                    </DockPanel>

                    <ListBox x:Name="LstHistory"
                             Grid.Row="1"
                             Background="#181C26"
                             BorderBrush="#2D3548"
                             Foreground="#F1F5F9"
                             HorizontalContentAlignment="Stretch"
                             MouseDoubleClick="LstHistory_MouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8,6" BorderBrush="#262D3D" BorderThickness="0,0,0,1">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock Text="{Binding LangPair}" Foreground="#60A5FA" FontSize="11" FontFamily="Segoe UI Semibold"/>
                                            <TextBlock Text="{Binding Provider}" Foreground="#64748B" FontSize="11" Margin="8,0,0,0"/>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding TimeDisplay}" Foreground="#64748B" FontSize="11"/>
                                        </DockPanel>
                                        <TextBlock Text="{Binding TranslatedText}" Foreground="#F8FAFC" FontSize="13" TextWrapping="Wrap" Margin="0,2,0,2"/>
                                        <TextBlock Text="{Binding SourceText}" Foreground="#94A3B8" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>
        </TabControl>

        <DockPanel Grid.Row="1" Margin="0,12,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Right"
                    Content="Lưu &amp; Đóng"
                    Width="120" Height="32"
                    Background="#2563EB" Foreground="White" BorderThickness="0"
                    FontFamily="Segoe UI Semibold"
                    Click="BtnSave_Click"/>
            <Button DockPanel.Dock="Right"
                    Content="Hủy"
                    Width="80" Height="32"
                    Margin="0,0,8,0"
                    Click="BtnCancel_Click"/>
        </DockPanel>
    </Grid>
</Window>
